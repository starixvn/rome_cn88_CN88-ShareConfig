<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=301880
  -->
<configuration>
  <configSections>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="AlphaAuthSection" type="Alpha.Auth.Configurations.AlphaAuthSection, Alpha.Auth" />
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
    <section name="ONEbook.UM" type="ONEbook.UM.Configurations.UMClientConfiguration, ONEbook.UM" />
  </configSections>

  <Fanex.Logging msmqPath="FormatName:DIRECT=http://10.40.40.127/msmq/Private$/entlib"
                 defaultCategory="Alpha-y987-AF" />
  <AlphaAuthSection enableAntiXSRF="true"
                    enableSessionValidation="true"
                    enableKickOutWhenSessionInvalid="false" />
  <ONEbook.UM ServiceUris="http://10.40.40.47:8889/api"
              EnableCheckUM="true"
              EnableUnscheduledUM="false"
              UMFrom="03:00" UMTo="04:00"
              SiteId="8" UMPageUrl="~/UserLogin/Common/Offline">
  </ONEbook.UM>

  <connectionStrings configSource="Web.ConnectionStrings.config" />
  <appSettings file="Web.AppSettings.config" />

  <system.web>
    <authorization>
      <deny users="?" />
      <allow users="*" />
    </authorization>

    <authentication mode="Forms">
      <forms loginUrl="/ex-main/_authorization/signin.aspx"
             defaultUrl="/site-main"
             path="/"
             name=".AGENTFORMSAUTH"
             protection="All" />
    </authentication>

    <customErrors mode="On" defaultRedirect="/site-main/error">
      <error statusCode="403" redirect="/site-main/error" />
      <error statusCode="404" redirect="/site-main/error" />
    </customErrors>
    <sessionState mode="StateServer"
                  timeout="10"
                  stateConnectionString="tcpip=10.40.40.20:42424" />
    <machineKey
		  validationKey="FD92DD9DC1598CEB327286FCEB6F2FC9AD81CF45AEC83EF133D25E360EEF585A30F126BBCFEB1B8BF228E68C44C330680E277B97FE390966193BF3A1F864EF39"
		  decryptionKey="5FCE220CA578A9DF6DD09F2EC21A861B83225486696F1B2CB0DF98F962B359EF"
		  validation="SHA1" decryption="AES" />
  </system.web>

  <location path="Whoami.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <runtime>
    <dependentAssembly>
      <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
      <bindingRedirect oldVersion="0.0.0.0-4.5.0.0" newVersion="4.5.0.0" />
    </dependentAssembly>
  </runtime>
  <system.web.extensions>
    <scripting>
      <webServices>
        <jsonSerialization maxJsonLength="2147483644" />
      </webServices>
    </scripting>
  </system.web.extensions>
</configuration>